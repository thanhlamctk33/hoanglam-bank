# Validated at startup by src/config/env.ts — a missing or malformed value
# aborts the process with a readable message instead of failing later.

NODE_ENV=development
DATABASE_URL="postgresql://hoanglam:hoanglam@localhost:5432/hoanglam_bank?schema=public"

# Must be at least 16 characters. The placeholder below is rejected outright
# when NODE_ENV=production — generate a real one, e.g. `openssl rand -hex 32`.
JWT_SECRET="change-this-dev-secret"

PORT=4000
CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL=info

# Optional — leave empty to run without AI. The assistant returns 503 and
# receipt OCR is skipped (receipts still upload, just without auto-filled
# title/amount).
ANTHROPIC_API_KEY=""
